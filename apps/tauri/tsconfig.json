{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Mirrors the aliases in vite.config.ts — vue-tsc must resolve them the
       same way Vite does, or the build typechecks something Vite never loads. */
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../packages/shared-ts/*"],
      "@sql/*": ["../../packages/core/spotify_core/db/sql/*"]
    }
  },
  "include": ["src", "../../packages/shared-ts/*.ts"],
  "exclude": ["../../packages/shared-ts/*.test.ts"]
}
