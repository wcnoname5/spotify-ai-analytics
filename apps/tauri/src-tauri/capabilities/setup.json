{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "setup",
  "description": "Capability for the Preferences (setup) window",
  "windows": [
    "setup"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://accounts.spotify.com/*" },
        { "url": "https://api.spotify.com/*" },
        { "url": "https://*.workers.dev" }
      ]
    }
  ]
}
