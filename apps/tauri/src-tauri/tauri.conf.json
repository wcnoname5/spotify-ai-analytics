{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spotify-analytics",
  "version": "0.1.0",
  "identifier": "com.wcnoname5.spotify-analytics",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "spotify-analytics",
        "width": 800,
        "height": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1QURDRDU4NjlFODREQjQKUldTMFRlaHBXTTJ0aFgrZXcxZjJwbnFVOFB6RlJPR0JyalJiQ3l2Wkl5bm9zSVlEenJxU21PVHgK",
      "endpoints": [
        "https://github.com/wcnoname5/spotify-ai-analytics/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
