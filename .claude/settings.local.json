{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree *)",
      "Bash(uv sync *)",
      "Bash(uv run *)",
      "Bash(uv pip *)",
      "Bash(git show *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/uv-convention-check.sh",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
