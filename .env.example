# Where config (.env) and data (history.db) live — three modes,
# highest priority first (see packages/core/spotify_core/paths.py):
#   1. SPOTIFY_MCP_CONFIG_DIR / SPOTIFY_MCP_DATA_DIR  — explicit override (CI sets SPOTIFY_MCP_DATA_DIR = ./data)
#   2. DEV=true                                       — repo checkout: .env + ./data here (for contributors only)
#   3. neither                                        — platformdirs (where installed users' .env and DBs live)
# Run `spotify-mcp doctor` to check which path is used (see its "paths" section).
LOG_LEVEL=INFO  # INFO|DEBUG

# Dev mode (contributors only): true = config (.env) and data/ live in this repo
DEV=false

# Spotify API authenntication
SPOTIFY_CLIENT_ID=
TOKEN_ENCRYPT_KEY=

SPOTIFY_USER_ID=default

# Cloudflare Worker API (setup_cloud.sh would generate and writes to GitHub secrets)
WORKER_URL=
WORKER_AUTH_TOKEN=

# Tauri app (apps/tauri) only
# Defaults to data/history.db (relative to the repo root) if unset.
# HISTORY_DB_PATH=

# optional for AI report block
OPENAI_API_KEY=
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=   # not yet supported by the report block

# optional Langfuse tracing for the report block (all 3 or none)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# optional LangSmith tracing for the report block
# change the endpoint if your registered region is different from the default
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com 
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=spotify-ai-analytics
