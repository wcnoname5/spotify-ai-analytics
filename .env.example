LOG_LEVEL=INFO

# OpenAI API Key (required for LLM)
OPENAI_API_KEY=your_openai_api_key_here
# Or use gemini
GEMINI_API_KEY=your_gemini_api_key_here

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret   # needed by auth flow internally
TOKEN_ENCRYPT_KEY=your_fernet_key_here   # 32 url-safe base64-encoded bytes, e.g. generated by `from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())`

# Optional: Model configuration
USE_GEMINI=true
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-3-small

# Data paths
SPOTIFY_DATA_PATH=data/spotify_history
VECTOR_DB_PATH=data/vectordb
