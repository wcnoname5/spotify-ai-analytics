# Where config (.env) and data (history.db) live — three modes,
# highest priority first (see packages/core/spotify_core/paths.py):
#   1. SPOTIFY_MCP_CONFIG_DIR / SPOTIFY_MCP_DATA_DIR  — explicit override (CI sets SPOTIFY_MCP_DATA_DIR = ./data)
#   2. DEV=true                                       — repo checkout: .env + ./data here (for contributors only)
#   3. neither                                        — platformdirs (where installed users' .env and DBs live)
# Run `spotify-mcp path` to check which path is used.
LOG_LEVEL=INFO  # INFO|DEBUG

# Dev mode (contributors only): true = config (.env) and data/ live in this repo
DEV=false

# REQUIRED
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
TOKEN_ENCRYPT_KEY=   # Fernet key — keep the SAME key your existing tokens were encrypted with

SPOTIFY_USER_ID=default

# Cloud setup (docs/DEPLOY.md step 0) — read by scripts/setup_cloud.sh and
# forwarded into GitHub Actions secrets; only needed to (re)provision the cron
CLOUDFLARE_ACCOUNT_ID=   # Cloudflare dashboard -> right sidebar
CLOUDFLARE_API_TOKEN=    # dash.cloudflare.com/profile/api-tokens: Workers Scripts:Edit + D1:Edit

# Worker API (local scripts: scripts/sync.py, run_local_sync) — same values
# setup_cloud.sh writes to GitHub secrets; needed locally to pull the D1 cache
WORKER_URL=          # https://<name>.workers.dev (printed by setup_cloud.sh / wrangler deploy)
WORKER_AUTH_TOKEN=   # the Bearer token passed to setup_cloud.sh

# AI report block (packages/core/spotify_core/report, LangGraph) — all
# optional; absence degrades gracefully
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here   # not yet supported by the report block

# optional Langfuse tracing for the report block (all 3 or none)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
