# Where config (.env) and data (history.db / tokens.db) live — three modes,
# highest priority first (see packages/core/spotify_core/paths.py):
#   1. SPOTIFY_MCP_CONFIG_DIR / SPOTIFY_MCP_DATA_DIR  — explicit override (CI set SPOTIFY_MCP_DATA_DIR = ./data)
#   2. DEV=true                                       — repo checkout: .env + ./data here (for contributors only)
#   3. neither                                        — platformdirs (what the wizard uses;
#      this is where installed/uvx users' .env and DBs actually live)
# Run `spotify-mcp path` to check which path is used.
#
# NOTE: this repo `.env` is only read in modes 1-2. Wizard-installed users have
# their real .env in the platformdirs config dir (spotify-mcp path shows it).
LOG_LEVEL=INFO  # INFO|DEBUG

# Dev mode (contributors only): true = config (.env) and data/ live in this
DEV=false

# REQUIRED
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
TOKEN_ENCRYPT_KEY=

SPOTIFY_USER_ID=default

# AI report block (apps/mcp/spotify_mcp/dashboard) — all optional; absence degrades gracefully
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here   # not yet supported by the report block

# optional for AI report block (apps/mcp/spotify_mcp/dashboard)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
