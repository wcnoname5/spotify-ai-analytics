# NOTE: .env are only for development use. Upon aplication using, install wizard will kept the keys in another path.
LOG_LEVEL=INFO

# Dev mode: true = config (.env) and data/ live in this repo checkout.
# Unset/false = production-like, platformdirs locations (what end users get).
DEV=true

# REQUIRED
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
TOKEN_ENCRYPT_KEY=

SPOTIFY_USER_ID=default # placeholder for future multi-user support; not used in single-user mode

# AI report block (apps/mcp/spotify_mcp/dashboard) — all optional; absence degrades gracefully
# Only GEMINI_API_KEY / OPENAI_API_KEY are wired up; ANTHROPIC is not yet supported.
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here   # not yet supported by the report block

# optional for AI report block (apps/mcp/spotify_mcp/dashboard)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
