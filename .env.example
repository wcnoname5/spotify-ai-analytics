# Where config (.env) and data (history.db) live — three modes,
# highest priority first (see packages/core/spotify_core/paths.py):
#   1. SPOTIFY_MCP_CONFIG_DIR / SPOTIFY_MCP_DATA_DIR  — explicit override (CI sets SPOTIFY_MCP_DATA_DIR = ./data)
#   2. DEV=true                                       — repo checkout: .env + ./data here (for contributors only)
#   3. neither                                        — platformdirs (where installed users' .env and DBs live)
# Run `spotify-mcp path` to check which path is used.
LOG_LEVEL=INFO  # INFO|DEBUG

# Dev mode (contributors only): true = config (.env) and data/ live in this repo
DEV=false

# Spotify API authenntication
SPOTIFY_CLIENT_ID=
TOKEN_ENCRYPT_KEY=

SPOTIFY_USER_ID=default

# Worker API — needed by local scripts that talk to D1 (scripts/local_sync.py,
# scripts/seed_d1.py). Same values setup_cloud.sh writes to GitHub secrets.
WORKER_URL=          # https://<name>.workers.dev (printed by setup_cloud.sh / wrangler deploy)
WORKER_AUTH_TOKEN=   # the Bearer token passed to setup_cloud.sh

# optional for AI report block
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here   # not yet supported by the report block

# optional Langfuse tracing for the report block (all 3 or none)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
